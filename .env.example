DOCKEROPS_HOST=0.0.0.0
DOCKEROPS_PORT=8080
DOCKEROPS_DATA_DIR=/data

# 无默认账号。账号仅存 /data/dockerops.db（内置 SQLite）。
# 首次打开 Web 向导创建超级管理员。
# 可选一次性预置：须同时取消注释并填写 USER + PASSWORD（≥6 位），启动写入 SQLite。
# DOCKEROPS_ADMIN_USER=
# DOCKEROPS_ADMIN_PASSWORD=

DOCKEROPS_API_TOKEN=
DOCKEROPS_DOCKER_HOST=unix:///var/run/docker.sock
TZ=Asia/Shanghai

# auto | unraid | fnos | generic
DOCKEROPS_PLATFORM=auto
# 日常运维资源 API（生命周期/日志/镜像/网络/卷/系统）
DOCKEROPS_RESOURCE_APIS=true
# Web 终端（高风险，默认关）
DOCKEROPS_CONSOLE_ENABLED=false

# 完整接管（compose up/down、Unraid 模板重建、Adopt、删除/prune）
DOCKEROPS_TAKEOVER_ENABLED=false
DOCKEROPS_COMPOSE_ENABLED=true
DOCKEROPS_COMPOSE_PROJECT_DIRS=
# 例: /compose 或 /mnt/user/appdata/compose-stacks ；飞牛常见 /compose
DOCKEROPS_UNRAID_ENABLED=true
DOCKEROPS_UNRAID_TEMPLATES_USER=/unraid/templates-user
DOCKEROPS_UNRAID_DOCKER_CFG=/unraid/docker.cfg

# Unraid 式后台更新检测（registry digest 缓存；容器列表直接显示可更新）
DOCKEROPS_UPDATE_AUTO_CHECK=true
DOCKEROPS_UPDATE_CHECK_INTERVAL_HOURS=6
# DOCKEROPS_UPDATE_CHECK_STARTUP_DELAY_SEC=60

# DockerOps 容器进程代理（可选）。标准名或 DOCKEROPS_* 均可；设置页会自动识别 env 并只读锁定。
# 注意：docker pull / 更新检测经 Docker 引擎出网，引擎代理需在 Unraid/宿主机配置。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# DOCKEROPS_HTTP_PROXY=
# DOCKEROPS_HTTPS_PROXY=
# DOCKEROPS_NO_PROXY=
