#!/bin/bash
### Called after install — normalize icons + ensure desktop launcher executable.

set -u
APP_ROOT="${TRIM_APPDEST:-/var/apps/dockerops/target}"
PKG_ROOT="$(dirname "${APP_ROOT}")"

SRC256="${APP_ROOT}/ui/images/icon_256.png"
SRC64="${APP_ROOT}/ui/images/icon_64.png"

if [ -f "${SRC256}" ]; then
  cp -f "${SRC256}" "${PKG_ROOT}/ICON.PNG" 2>/dev/null || true
  cp -f "${SRC256}" "${PKG_ROOT}/ICON_256.PNG" 2>/dev/null || true
  cp -f "${SRC256}" "${APP_ROOT}/ICON.PNG" 2>/dev/null || true
  cp -f "${SRC256}" "${APP_ROOT}/ICON_256.PNG" 2>/dev/null || true
fi
if [ -f "${SRC64}" ]; then
  cp -f "${SRC64}" "${APP_ROOT}/ui/images/icon_64.png" 2>/dev/null || true
fi

# Desktop launcher + scripts
chmod +x "${APP_ROOT}/cmd/"* 2>/dev/null || true
chmod +x "${APP_ROOT}/ui/index.cgi" 2>/dev/null || true

# Default port file (overwritten on start with wizard port)
if [ ! -f "${APP_ROOT}/ui/port" ]; then
  echo "8080" > "${APP_ROOT}/ui/port" 2>/dev/null || true
fi

exit 0
